diff --git a/tests/e2e/harness.py b/tests/e2e/harness.py
new file mode 100644
index 0000000..342a7ab
--- /dev/null
+++ b/tests/e2e/harness.py
@@ -0,0 +1,72 @@
+"""E2E harness: serves the repo as https://kalimat.test and fakes ONLY Supabase + Cloudinary (in memory), so real browsers run the real app.
+Requires: pip install playwright && playwright install chromium.  The fake mirrors the RLS rules in supabase/migrations."""
+import json, mimetypes, os, time
+from urllib.parse import urlparse, parse_qs
+ROOT = os.environ.get('KALIMAT_ROOT') or os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..')); ORIGIN = 'https://kalimat.test'
+CONFIG = json.load(open(os.path.join(os.path.dirname(__file__), 'fixtures', 'config.json')))
+PUBLIC = {'config', 'categories', 'promotions', 'policies', 'businessProfile', 'tutorial'}
+ADMIN_JWT = 'ADMINJWT'
+PNG = bytes.fromhex('89504e470d0a1a0a0000000d49484452000000010000000108060000001f15c4890000000d4944415478da63f8cfc0f01f0005000201a1b8ac1c0000000049454e44ae426082')
+QR = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=='
+
+class Backend:
+    def __init__(self, config_delay=0.0, fail_writes=0, theme=None, headline=None):
+        cfg = json.loads(json.dumps(CONFIG)); cfg['theme'].update(theme or {})
+        if headline is not None: cfg['content']['headline'] = headline
+        self.rows = {('config', '_'): cfg}; self.log = []; self.config_delay = config_delay; self.fail_writes = fail_writes
+        for i, (n, cat) in enumerate((('Woven Basket', 'Home'), ('Kitenge Bag', 'Fashion'))):
+            self.rows[('products', f'p{i+1}')] = {"id": f'p{i+1}', "name": n, "price": 9000 + i * 6000, "category": cat, "images": ["https://res.cloudinary.com/xezz9csp/image/upload/v1/x.png"], "stock": 1, "sale": "available", "status": "active", "featured": True, "costPrice": 4000, "shopId": "kalimat"}
+    def visible(self, admin): return [(c, i, d) for (c, i), d in self.rows.items() if admin or c in PUBLIC]
+    def coll(self, c): return [d for (cc, i), d in self.rows.items() if cc == c]
+
+def install(page, be):
+    def sb(route, req):
+        u = req.url; H = lambda b, s=200: route.fulfill(status=s, content_type='application/json', headers={'access-control-allow-origin': '*'}, body=json.dumps(b))
+        adm = ADMIN_JWT in req.headers.get('authorization', ''); q = parse_qs(urlparse(u).query)
+        if req.method == 'OPTIONS': return route.fulfill(status=204, headers={'access-control-allow-origin': '*', 'access-control-allow-headers': '*', 'access-control-allow-methods': '*'})
+        if '/functions/v1/kal-admin' in u:
+            b = json.loads(req.post_data); a = b['action']
+            if a == 'status': return H({"enrolled": False})
+            if a == 'enroll': return H({"secret": "JBSWY3DPEHPK3PXP", "qr": QR}) if b.get('setup_key') == 'KEY-123' else H({"error": "bad_key"}, 403)
+            if a == 'login': return H({"token_hash": "th", "email": b['email']}) if b['code'] == '123456' else H({"error": "invalid"}, 401)
+        if '/auth/v1/verify' in u: return H({"access_token": ADMIN_JWT, "refresh_token": "r", "expires_in": 3600, "user": {"email": "owner@kalimat.co.rw"}})
+        if '/rpc/public_products' in u: return H([{"id": i, "data": {k: v for k, v in d.items() if k != 'costPrice'}} for c, i, d in be.visible(False) if False] + [{"id": i, "data": {k: v for k, v in d.items() if k != 'costPrice'}} for (c, i), d in be.rows.items() if c == 'products'])
+        if '/rpc/' in u: return H(True)
+        if '/rest/v1/records' in u:
+            if req.method == 'GET':
+                if be.config_delay: time.sleep(be.config_delay)
+                rows = be.visible(adm); fc, fi = q.get('coll', [None])[0], q.get('id', [None])[0]
+                if fc: rows = [r for r in rows if r[0] == fc.replace('eq.', '')]
+                if fi: rows = [r for r in rows if r[1] == fi.replace('eq.', '')]
+                off = int(q.get('offset', ['0'])[0]); lim = min(int(q.get('limit', ['1000'])[0]), 1000)
+                return H([{"coll": c, "id": i, "data": d} for c, i, d in rows][off:off + lim])
+            if req.method == 'POST':
+                if be.fail_writes > 0: be.fail_writes -= 1; return H({"message": "boom"}, 500)
+                b = json.loads(req.post_data)
+                if not adm and b['coll'] not in ('orders', 'customers', 'customerDemands'): return H({"code": "42501", "message": "rls"}, 401)
+                be.rows[(b['coll'], b['id'])] = b['data']; be.log.append(('write', b['coll'], b['id']))
+                return H([b], 201) if 'representation' in req.headers.get('prefer', '') else route.fulfill(status=201, headers={'access-control-allow-origin': '*'}, body='')
+            if req.method == 'DELETE':
+                i = q['id'][0].replace('eq.', ''); c = q['coll'][0].replace('eq.', ''); gone = be.rows.pop((c, i), None); be.log.append(('delete', c, i))
+                return H([{"id": i}] if gone is not None else [])
+        return H({})
+    def local(route, req):
+        u = req.url
+        if u.startswith(ORIGIN):
+            p = urlparse(u).path
+            if p == '/admin' or p == '/admin/': p = '/admin.html'
+            if p == '/': p = '/index.html'
+            f = ROOT + p
+            if os.path.isfile(f): return route.fulfill(status=200, content_type=mimetypes.guess_type(f)[0] or 'text/plain', body=open(f, 'rb').read())
+            return route.fulfill(status=404, body='')
+        if 'res.cloudinary.com' in u: return route.fulfill(status=200, content_type='image/png', body=PNG)
+        if 'api.cloudinary.com' in u: return route.fulfill(status=200, content_type='application/json', headers={'access-control-allow-origin': '*'}, body=json.dumps({'secure_url': 'https://res.cloudinary.com/xezz9csp/image/upload/v1/up.png'}))
+        if 'supabase.co' in u: return sb(route, req)
+        return route.fulfill(status=200, content_type='text/css' if 'css' in u else 'text/plain', body='')
+    page.route('**/*', lambda r: local(r, r.request))
+
+def admin_login(page):
+    page.goto(ORIGIN + '/admin'); page.wait_for_selector('input', timeout=20000); page.wait_for_timeout(1500)
+    page.locator('input').first.fill('owner@kalimat.co.rw'); page.once('dialog', lambda d: d.accept('KEY-123'))
+    page.get_by_role('button', name='Continue').click(); page.wait_for_timeout(1200)
+    page.locator('input').last.fill('123456'); page.get_by_role('button', name='Confirm setup').click(); page.wait_for_timeout(2500)
diff --git a/tests/e2e/test_regressions.py b/tests/e2e/test_regressions.py
new file mode 100644
index 0000000..2799fc8
--- /dev/null
+++ b/tests/e2e/test_regressions.py
@@ -0,0 +1,66 @@
+"""Browser regression tests (real Chromium, real app code, faked Supabase). Run: python3 tests/e2e/test_regressions.py  [ONLY=name]
+Optional: KALIMAT_ROOT=/path/to/another/checkout runs the same tests against that tree (used to prove a test fails on old code)."""
+import os, sys, json, traceback
+sys.path.insert(0, os.path.dirname(__file__))
+from harness import *
+from playwright.sync_api import sync_playwright
+BLUE = {'accent': '#1d4ed8', 'gradientFrom': '#2563eb', 'gradientTo': '#1e40af'}
+SAMPLER = """window.__s=[];(function t(){var r=document.documentElement,b=document.body;if(r)window.__s.push([Math.round(performance.now()),getComputedStyle(r).getPropertyValue('--g1').trim().toLowerCase(),b?getComputedStyle(b).visibility:'none']);if(performance.now()<3500)requestAnimationFrame(t)})()"""
+def ctx(br, **kw): return br.new_context(viewport={'width': 390, 'height': 844}, service_workers='block', **kw)
+def page(c, be, sampler=False):
+    pg = c.new_page(); install(pg, be)
+    if sampler: pg.add_init_script(SAMPLER)
+    return pg
+def text(pg): return pg.inner_text('body')
+
+def t_brand_first_visit(br):
+    """Saved brand is authoritative: a first-ever visit never paints an older/default scheme, then switches."""
+    be = Backend(config_delay=1.2, theme=BLUE); pg = page(ctx(br), be, True); pg.goto(ORIGIN + '/'); pg.wait_for_timeout(3600)
+    s = pg.evaluate('window.__s'); shown = [x for x in s if x[2] not in ('hidden', 'none') and x[1]]
+    bad = [x for x in shown if x[1] != '#2563eb']
+    assert not bad, f'{len(bad)} visible frames used a non-saved brand colour, first: {bad[0]}'
+    assert s[-1][1] == '#2563eb' and s[-1][2] != 'hidden', f'final frame {s[-1]}'
+def t_brand_returning_visit(br):
+    """A returning visitor sees the saved brand from the very first frame."""
+    be = Backend(config_delay=1.2, theme=BLUE); c = ctx(br); pg = page(c, be); pg.goto(ORIGIN + '/'); pg.wait_for_timeout(2500); pg.close()
+    pg = page(c, be, True); pg.goto(ORIGIN + '/'); pg.wait_for_timeout(1800); s = pg.evaluate('window.__s'); vis = [x for x in s if x[2] not in ('hidden', 'none') and x[1]]
+    assert vis and all(x[1] == '#2563eb' for x in vis), f'first visible frame: {vis[:1]}'
+def t_no_default_slogan(br):
+    """No built-in marketing slogan is ever shown; a configured headline is."""
+    pg = page(ctx(br), Backend(headline=''), True); pg.goto(ORIGIN + '/'); pg.wait_for_timeout(1800); t = text(pg)
+    assert 'Shop Smarter' not in t and 'Live Better' not in t, 'default slogan visible'
+    be = Backend(headline='Fresh picks'); pg2 = page(ctx(br), be); pg2.goto(ORIGIN + '/'); pg2.wait_for_timeout(1800); assert 'Fresh picks' in text(pg2)
+def t_no_brand_reset_button(br):
+    """There is no Reset control on the Branding screen (it used to wipe the logo and favicon)."""
+    assert 'children: "Reset"' not in open(os.path.join(ROOT, 'admin.html'), encoding='utf-8').read(), 'Reset button still in admin code'
+    pg = page(ctx(br), Backend()); admin_login(pg); pg.get_by_text('Platform Management').first.click(); pg.wait_for_timeout(700)
+    pg.get_by_role('button', name='Branding').first.click(); pg.wait_for_timeout(900)
+    assert pg.get_by_role('button', name='Reset', exact=True).count() == 0, 'Reset button visible'
+def _open_categories(pg):
+    pg.get_by_text('Business Management').first.click(); pg.wait_for_timeout(500); pg.get_by_role('button', name='Categories').first.click(); pg.wait_for_timeout(800)
+def t_category_saved_in_database_and_on_other_device(br):
+    """A category created on one device is stored in the database and appears on another device."""
+    be = Backend(); pg = page(ctx(br), be); admin_login(pg); _open_categories(pg)
+    pg.get_by_placeholder('New category').fill('Kids clothes'); pg.get_by_role('button', name='Add category').click(); pg.wait_for_timeout(1200)
+    saved = [c for c in be.coll('categories')]; assert saved and any(x.get('name') == 'Kids clothes' for x in (saved[0] if isinstance(saved[0], list) else saved)), f'not in database: {saved}'
+    pg2 = page(ctx(br), be); admin_login(pg2); _open_categories(pg2); assert 'Kids clothes' in text(pg2), 'not visible on the second device'
+def t_failed_category_save_is_not_reported_as_success(br):
+    """If the database refuses the write the owner sees an error, never 'Category added', and nothing stays on screen."""
+    be = Backend(fail_writes=1); pg = page(ctx(br), be); admin_login(pg); _open_categories(pg)
+    pg.get_by_placeholder('New category').fill('Ghost'); pg.get_by_role('button', name='Add category').click(); pg.wait_for_timeout(1500); t = text(pg)
+    assert 'Category added' not in t, 'false success shown'
+    assert 'not saved' in t or 'server had a problem' in t, 'no error message shown'
+    assert not be.coll('categories'), 'record should not exist'
+    assert 'Ghost' not in t, 'unsaved category still on screen'
+
+TESTS = [v for k, v in sorted(globals().items()) if k.startswith('t_')]
+if __name__ == '__main__':
+    only = os.environ.get('ONLY'); fails = 0
+    with sync_playwright() as p:
+        br = p.chromium.launch()
+        for fn in TESTS:
+            if only and only not in fn.__name__: continue
+            try: fn(br); print('PASS', fn.__name__)
+            except Exception as e: fails += 1; print('FAIL', fn.__name__, '-', str(e).splitlines()[0][:230])
+        br.close()
+    print(f'\n{len(TESTS) - fails if not only else "-"} passed, {fails} failed'); sys.exit(1 if fails else 0)
-- 
