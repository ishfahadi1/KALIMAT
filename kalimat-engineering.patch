+document.addEventListener("keydown",function(e){var el=$("zv");if(!el||!el.classList.contains("on"))return;if(e.key==="Escape")zClose();else if(e.key==="ArrowLeft")zGo(-1);else if(e.key==="ArrowRight")zGo(1)});
